{
  "name": "@os-tools/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --include \"../tools_shared/dist/**/*.js\" app/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint app --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app"
  },
  "dependencies": {
    "@orpc/server": "1.16.1",
    "@os-tools/shared": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "morgan": "^1.12.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.1.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  }
}
